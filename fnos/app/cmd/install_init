#!/bin/bash
# Runs before the app files install. Generates the magpie web key into the
# app data directory (it survives upgrades and uninstalls with the data),
# where the compose file's env_file picks it up. Idempotent: an existing
# key is kept.
set -eu

KEY_FILE="${TRIM_PKGVAR}/magpie.env"

generate_key() {
	# 32 hex chars; magpie's CheckWebKey takes letters, digits and - . _ ~
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -hex 16
	else
		head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
	fi
}

mkdir -p "${TRIM_PKGVAR}"

if [ ! -s "$KEY_FILE" ]; then
	KEY="$(generate_key)"
	{
		echo "# Generated by the magpie fnOS app installer. The web key signs in"
		echo "# browsers to magpie web; the bridge hands it to fnOS-authenticated"
		echo "# sessions as a cookie. Do not commit."
		echo "MAGPIE_WEB_KEY=${KEY}"
	} >"$KEY_FILE"
	chmod 600 "$KEY_FILE"
fi
