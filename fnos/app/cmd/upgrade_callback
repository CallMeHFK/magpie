#!/bin/bash
# Runs after the app files are replaced by an upgrade. The key file lives in
# the app data directory and survives untouched; make sure it is there (an
# upgrade from a very old packaging may not have it), then pull the pinned
# images so the restart after the upgrade serves the new version.
set -eu

KEY_FILE="${TRIM_PKGVAR}/magpie.env"

mkdir -p "${TRIM_PKGVAR}"

if [ ! -s "$KEY_FILE" ]; then
	KEY="$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
	echo "MAGPIE_WEB_KEY=${KEY}" >"$KEY_FILE"
	chmod 600 "$KEY_FILE"
fi

# Best effort: the pinned image tags changed with the upgrade.
docker compose -f "${TRIM_APPDEST}/app/docker/docker-compose.yaml" pull --ignore-pull-failures || true
