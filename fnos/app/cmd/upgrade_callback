#!/bin/bash
# Runs after an upgrade replaced the app files. The upgrade wiped the key
# file that lives inside the package directory; regenerate it (browsers
# then sign in to magpie web once more), and pull the pinned images so the
# restart after the upgrade serves the new version.
set -eu

KEY_FILE="${TRIM_APPDEST}/app/docker/magpie.env"

if [ ! -s "$KEY_FILE" ]; then
	KEY="$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
	echo "MAGPIE_WEB_KEY=${KEY}" >"$KEY_FILE"
	chmod 600 "$KEY_FILE"
fi

# Best effort: the pinned image tags changed with the upgrade.
docker compose -f "${TRIM_APPDEST}/app/docker/docker-compose.yaml" pull --ignore-pull-failures || true
