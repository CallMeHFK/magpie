#!/bin/bash
# Runs after an upgrade replaced the app files. There is no key file to
# restore: the bridge generates <target>/magpie.env at every container
# start and hands it to the magpie container's uid, so an upgrade simply
# makes browsers sign in to magpie web once more.
# Pull the pinned images so the restart after the upgrade serves the new
# version.
set -eu
. "$(dirname "$0")/common.sh"

TARGET="$(find_target)" || {
	logger -t magpie-app "upgrade_callback: cannot locate the app target" 2>/dev/null
	exit 1
}

# Best effort: the pinned image tags changed with the upgrade.
docker compose -f "${TARGET}/docker/docker-compose.yaml" pull --ignore-pull-failures || true
