#!/bin/bash
# Runs after the app files land in ${TRIM_APPDEST}. Creates the app's secret
# env file (the magpie web key) once, in the app-conf directory where it
# survives upgrades, and copies it next to the compose file as .env so
# docker compose interpolates ${MAGPIE_WEB_KEY}.
set -eu

KEY_FILE="${TRIM_PKGETC}/magpie.env"
ENV_FILE="${TRIM_APPDEST}/app/docker/.env"

generate_key() {
	# 32 hex chars; magpie's CheckWebKey takes letters, digits and - . _ ~
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -hex 16
	else
		head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
	fi
}

mkdir -p "${TRIM_PKGETC}" "${TRIM_APPDEST}/app/docker"

if [ ! -s "$KEY_FILE" ]; then
	KEY="$(generate_key)"
	{
		echo "# Generated by the magpie fnOS app installer. The web key signs in"
		echo "# browsers to magpie web; the bridge hands it to fnOS-authenticated"
		echo "# sessions as a cookie. Do not commit."
		echo "MAGPIE_WEB_KEY=${KEY}"
	} >"$KEY_FILE"
	chmod 600 "$KEY_FILE"
fi

cp -f "$KEY_FILE" "$ENV_FILE"
chmod 600 "$ENV_FILE"
