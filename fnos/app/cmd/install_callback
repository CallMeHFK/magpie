#!/bin/bash
# Runs after the app files land in ${TRIM_APPDEST}. The key file already
# exists (cmd/install_init generated it before the install); this is the
# idempotent backstop for reinstalls where the data dir was kept.
set -eu

KEY_FILE="${TRIM_PKGVAR}/magpie.env"

generate_key() {
	if command -v openssl >/dev/null 2>&1; then
		openssl rand -hex 16
	else
		head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
	fi
}

mkdir -p "${TRIM_PKGVAR}"

if [ ! -s "$KEY_FILE" ]; then
	KEY="$(generate_key)"
	{
		echo "MAGPIE_WEB_KEY=${KEY}"
	} >"$KEY_FILE"
	chmod 600 "$KEY_FILE"
fi
